# Dependencies & Package Managers
node_modules/
dist/
build/
out/
.cache/
portables/**/cache/
*.tsbuildinfo

# Submodule Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Submodule Local Database & Transients
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
backups/db/*
