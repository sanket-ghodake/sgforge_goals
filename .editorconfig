# ==============================================================================
# EditorConfig Configuration - Forge Micro-App Submodule (2026 LTS)
# http://editorconfig.org
# ==============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,html,css}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
