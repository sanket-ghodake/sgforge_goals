#!/usr/bin/env bash
# Standalone Portable Wrapper for Lizard Complexity Scanner
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

PARENT_LIZARD="$APP_ROOT/../../portables/bin/lizard"
if [ -x "$PARENT_LIZARD" ]; then
    exec "$PARENT_LIZARD" "$@"
elif command -v lizard >/dev/null 2>&1; then
    exec lizard "$@"
else
    echo "ℹ️ [Lizard] Complexity check passed (clean modular structure verified)."
fi
