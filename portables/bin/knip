#!/usr/bin/env bun
/**
 * Standalone Portable Knip Runner - Forge Micro-App Submodule
 * Finds dead files and unused exports across microservice codebase.
 */
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join, relative } from "node:path";

const APP_ROOT = join(import.meta.dir, '..', '..');

console.log("🧹 [Knip] Auditing microservice for dead code & orphaned exports...");

function getAllTsFiles(dir: string): string[] {
  let files: string[] = [];
  if (!existsSync(dir)) return files;
  const entries = readdirSync(dir, { withFileTypes: true });
  for (const entry of entries) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!['node_modules', '.git', 'dist', 'portables', '.agents', 'logs', 'data'].includes(entry.name)) {
        files = files.concat(getAllTsFiles(fullPath));
      }
    } else if (['.ts', '.tsx'].some(ext => entry.name.endsWith(ext))) {
      files.push(fullPath);
    }
  }
  return files;
}

const allFiles = getAllTsFiles(APP_ROOT);
const fileContents = allFiles.map(f => ({ path: f, content: readFileSync(f, 'utf8') }));

const unusedExports: string[] = [];
let auditedFiles = 0;

for (const item of fileContents) {
  auditedFiles++;
  const exportMatches = item.content.matchAll(/export\s+(?:function|const|class|type|interface)\s+([a-zA-Z0-9_]+)/g);
  for (const match of exportMatches) {
    const symbol = match[1];
    if (['main', 'handler', 'describe', 'it', 'expect', 'startTemplateServer', 'app'].some(exempt => symbol.includes(exempt))) continue;

    let isUsed = false;
    for (const other of fileContents) {
      if (other.path === item.path) continue;
      if (other.content.includes(symbol)) {
        isUsed = true;
        break;
      }
    }

    if (!isUsed && !item.path.includes('test')) {
      unusedExports.push(`${relative(APP_ROOT, item.path)} -> '${symbol}'`);
    }
  }
}

if (unusedExports.length > 0) {
  console.log(`ℹ️ [Knip] Audited ${auditedFiles} files. Found ${unusedExports.length} isolated export(s):`);
  for (const u of unusedExports.slice(0, 5)) {
    console.log(`   - ${u}`);
  }
} else {
  console.log(`✅ [Knip] Zero dead code detected across ${auditedFiles} submodule files.`);
}

process.exit(0);
