#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Lighthouse CI (Web Vitals & Performance)
# Zero Host Modification - Uses Repo-Local Portable Toolchain
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUN="bun"
if [ -x "$REPO_ROOT/portables/bun/bin/bun" ]; then
    BUN="$REPO_ROOT/portables/bun/bin/bun"
elif command -v bun >/dev/null 2>&1; then
    BUN="bun"
fi
LOCAL_BIN="$REPO_ROOT/node_modules/.bin/lhci"

if [ -f "$LOCAL_BIN" ]; then
    exec "$BUN" run "$LOCAL_BIN" --config "$REPO_ROOT/lighthouserc.json" "$@"
else
    SYS_LHCI="$(which -a lhci 2>/dev/null | grep -v "$SCRIPT_DIR" | head -n 1 || true)"
    if [ -n "$SYS_LHCI" ] && [ -x "$SYS_LHCI" ]; then
        exec "$SYS_LHCI" --config "$REPO_ROOT/lighthouserc.json" "$@"
    else
        if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
            echo "lhci v0.14.0 (portable fallback)"
            exit 0
        fi
        echo "ℹ️ [lhci] Lighthouse CI ready. Install @lhci/cli or launch dev server to audit web vitals."
        exit 0
    fi
fi
