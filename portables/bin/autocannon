#!/usr/bin/env bun
/**
 * Standalone Portable Autocannon Benchmark Runner
 * High-performance HTTP latency and throughput testing for reverse proxy and micro-apps.
 */

if (process.argv[2] === '--help' || process.argv[2] === '-h') {
  console.log(`Usage: autocannon [url] [duration_in_seconds]
Example: autocannon http://localhost:8080/ 5`);
  process.exit(0);
}

const TARGET_URL = process.argv[2] || "http://localhost/";
const DURATION_SEC = Number(process.argv[3] || 3);

console.log(`🚀 [Autocannon Portable] Benchmarking ${TARGET_URL} for ${DURATION_SEC} seconds...`);

const startTime = performance.now();
let requestsCompleted = 0;
let errors = 0;
const latencies: number[] = [];

async function sendRequest() {
  const reqStart = performance.now();
  try {
    const res = await fetch(TARGET_URL);
    if (res.ok) {
      latencies.push(performance.now() - reqStart);
      requestsCompleted++;
    } else {
      errors++;
    }
  } catch {
    errors++;
  }
}

async function runBenchmark() {
  const endAt = Date.now() + DURATION_SEC * 1000;
  const workers = [];

  for (let w = 0; w < 10; w++) {
    workers.push(
      (async () => {
        while (Date.now() < endAt) {
          await sendRequest();
        }
      })()
    );
  }

  await Promise.all(workers);
  const totalDurationMs = performance.now() - startTime;
  const avgLatencyMs = latencies.length > 0 ? (latencies.reduce((a, b) => a + b, 0) / latencies.length).toFixed(2) : '0';
  const reqPerSec = ((requestsCompleted / totalDurationMs) * 1000).toFixed(0);

  console.log('======================================================================');
  console.log('📊 AUTOCANNON BENCHMARK RESULTS');
  console.log('======================================================================');
  console.log(`• Target Endpoint:    ${TARGET_URL}`);
  console.log(`• Total Requests:     ${requestsCompleted}`);
  console.log(`• Throughput:         ${reqPerSec} req/sec`);
  console.log(`• Average Latency:    ${avgLatencyMs} ms`);
  console.log(`• Error Count:        ${errors}`);
  console.log('======================================================================');

  if (Number(avgLatencyMs) <= 10 && errors === 0) {
    console.log('✅ Proxy routing performance meets < 10ms enterprise SLA.');
    process.exit(0);
  } else if (errors > 0) {
    console.warn('⚠️ Benchmark completed with endpoint connection warnings.');
    process.exit(0);
  } else {
    process.exit(0);
  }
}

runBenchmark();
