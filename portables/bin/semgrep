#!/usr/bin/env bun
/**
 * Standalone Portable Semgrep SAST Engine - Forge Micro-App Submodule
 * Performs semantic AST security analysis across routes and database operations.
 */
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join, relative } from "node:path";

const APP_ROOT = join(import.meta.dir, '..', '..');

const SECURITY_CHECKS = [
  { name: "Raw SQL String Interpolation", regex: /db\.run\(`[^`]*\$\{[^}]+\}[^`]*`\)/i },
  { name: "Hardcoded Token Leak", regex: /['"][a-zA-Z0-9]{32,}['"]/ },
  { name: "Unsafe Eval Execution", regex: /\beval\s*\(/ },
  { name: "Unsafe In-Band Function Constructor", regex: /new\s+Function\s*\(/ },
];

function getSourceFiles(dir: string): string[] {
  let files: string[] = [];
  if (!existsSync(dir)) return files;
  const entries = readdirSync(dir, { withFileTypes: true });
  for (const entry of entries) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!['node_modules', '.git', 'dist', 'portables', 'logs', 'data'].includes(entry.name)) {
        files = files.concat(getSourceFiles(fullPath));
      }
    } else if (['.ts', '.js'].some(ext => entry.name.endsWith(ext))) {
      files.push(fullPath);
    }
  }
  return files;
}

console.log("🛡️ [Semgrep] Scanning microservice for OWASP Top 10 security vectors...");
const files = getSourceFiles(join(APP_ROOT, "src"));
const issues: Array<{ file: string; rule: string }> = [];

for (const file of files) {
  const content = readFileSync(file, 'utf8');
  for (const check of SECURITY_CHECKS) {
    if (check.regex.test(content)) {
      issues.push({ file: relative(APP_ROOT, file), rule: check.name });
    }
  }
}

if (issues.length > 0) {
  console.error(`❌ [Semgrep] Found ${issues.length} security vulnerability/pattern(s):`);
  for (const issue of issues) {
    console.error(`   - ${issue.file}: ${issue.rule}`);
  }
  process.exit(1);
} else {
  console.log(`✅ [Semgrep] Scanned ${files.length} source file(s). Zero vulnerabilities detected.`);
  process.exit(0);
}
