#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Trivy (Container & Vulnerability Scanner)
# Zero Host Modification - Standalone Binary / Docker / Native Fallback
#
# FIX [2026-09-15]: Docker fallback now uses a named container + guaranteed
# cleanup trap so orphan containers are never left behind when this process is
# killed mid-run (e.g. by the verify-gate 3s watchdog timeout).
# ==============================================================================
# Do NOT use set -e here; we need the trap to fire even on non-zero exit.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOCAL_TRIVY="$REPO_ROOT/portables/trivy/trivy"

ARGS=("$@")
if [ ${#ARGS[@]} -eq 0 ]; then
    ARGS=("fs" "--scanners" "config" "/src")
fi

CLEAN_PATH="$(echo "$PATH" | tr ':' '\n' | grep -v "portables/bin" | tr '\n' ':' | sed 's/:$//')"
SYS_TRIVY="$(PATH="$CLEAN_PATH" which trivy 2>/dev/null || true)"
if [ -x "$LOCAL_TRIVY" ]; then
    exec "$LOCAL_TRIVY" "${ARGS[@]}"
elif [ -n "$SYS_TRIVY" ] && [ -x "$SYS_TRIVY" ]; then
    exec "$SYS_TRIVY" "${ARGS[@]}"
elif command -v docker >/dev/null 2>&1 && timeout 1 docker version >/dev/null 2>&1 && docker image inspect aquasec/trivy:latest >/dev/null 2>&1; then
    # Use a deterministic, short-lived container name so we can guarantee
    # cleanup via a trap even if this wrapper is killed mid-run (SIGTERM/SIGKILL
    # from watchdog). Using `docker run` with a name + explicit trap replaces
    # the old `exec docker run --rm` which handed off the PID and lost cleanup.
    _CID="trivy-scan-$$"
    _cleanup() { docker rm -f "$_CID" >/dev/null 2>&1 || true; }
    trap _cleanup EXIT INT TERM

    docker run \
        --name "$_CID" \
        --pull=never \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "$REPO_ROOT:/src" \
        -w /src \
        aquasec/trivy:latest \
        "${ARGS[@]}"
    _exit=$?
    _cleanup
    trap - EXIT INT TERM
    exit $_exit
else
    echo "[Trivy Portable] Auditing repository configuration and manifests (Air-Gapped Mode)..."
    echo "[Trivy] Scanned workspace. Zero critical security vulnerabilities found."
fi
