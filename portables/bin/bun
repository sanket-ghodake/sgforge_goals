#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Bun Wrapper - Forge Micro-App Submodule (2026 LTS)
# 3-Tier Resolution: Local Submodule -> Parent Monorepo -> Host System
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

LOCAL_BUN="$APP_ROOT/portables/bun/bin/bun"
PARENT_BUN="$APP_ROOT/../../portables/bun/bin/bun"

if [ -x "$LOCAL_BUN" ]; then
    exec "$LOCAL_BUN" "$@"
elif [ -x "$LOCAL_BUN.exe" ]; then
    exec "$LOCAL_BUN.exe" "$@"
elif [ -x "$PARENT_BUN" ]; then
    exec "$PARENT_BUN" "$@"
elif [ -x "$PARENT_BUN.exe" ]; then
    exec "$PARENT_BUN.exe" "$@"
else
    echo "📥 In-repo Bun runtime not found. Bootstrapping portable Bun into ./portables/bun..." >&2
    mkdir -p "$APP_ROOT/portables/bun"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://bun.sh/install | BUN_INSTALL="$APP_ROOT/portables/bun" bash >/dev/null 2>&1 || true
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- https://bun.sh/install | BUN_INSTALL="$APP_ROOT/portables/bun" bash >/dev/null 2>&1 || true
    fi
    chmod +x "$LOCAL_BUN" 2>/dev/null || true
    if [ -x "$LOCAL_BUN" ]; then
        exec "$LOCAL_BUN" "$@"
    else
        echo "❌ [Forge App] In-repo Bun runtime could not be resolved or bootstrapped." >&2
        echo "   👉 Run 'bash setup.sh' to bootstrap the environment." >&2
        exit 1
    fi
fi
