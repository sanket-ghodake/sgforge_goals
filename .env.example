# ==============================================================================
# Forge Micro-App Submodule Environment Configuration (2026 LTS)
# Minimal, deterministic, zero-randomness parameters
# ==============================================================================

# Core App Identity & Port (Containers, volumes & database are derived automatically)
APP_NAME=goals
PORT=8090
CONTAINER_PREFIX=forge
NODE_ENV=development

# Central Forge Platform Integration (Actual Employees, Manager & Department)
FORGE_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8080/auth
JWT_SECRET=dev-portable-secret-key-that-is-at-least-32-characters-long
